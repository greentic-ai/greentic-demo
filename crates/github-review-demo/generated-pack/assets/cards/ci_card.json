{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "size": "Large",
      "weight": "Bolder",
      "text": "Recent CI failures — {{payload.org}}/{{payload.repo}}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Workflow runs that did not pass.",
      "isSubtle": true,
      "wrap": true
    },
    {
      "type": "TextBlock",
      "wrap": true,
      "text": "{{#each payload.result}}- ❌ [{{display_title}}]({{html_url}}) — _{{head_branch}}_ ({{conclusion}})\n{{else}}No recent CI failures. ✅{{/each}}"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "⟵ Back to repos",
      "data": { "action": "pick_org", "org": "{{payload.org}}" }
    },
    {
      "type": "Action.Submit",
      "title": "Pick another org",
      "data": { "action": "home" }
    }
  ]
}
