{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "size": "Large",
      "weight": "Bolder",
      "text": "Today's Attendance",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Live pets from the petstore API (status: available). Showing the first 5.",
      "isSubtle": true,
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "${result.0.name||(none)}",
          "value": "id ${result.0.id||-} · ${result.0.status||-}"
        },
        {
          "title": "${result.1.name||(none)}",
          "value": "id ${result.1.id||-} · ${result.1.status||-}"
        },
        {
          "title": "${result.2.name||(none)}",
          "value": "id ${result.2.id||-} · ${result.2.status||-}"
        },
        {
          "title": "${result.3.name||(none)}",
          "value": "id ${result.3.id||-} · ${result.3.status||-}"
        },
        {
          "title": "${result.4.name||(none)}",
          "value": "id ${result.4.id||-} · ${result.4.status||-}"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Refresh",
      "style": "positive",
      "data": { "action_id": "list_pets", "operation": "list_pets", "page": "0" }
    },
    {
      "type": "Action.Submit",
      "title": "Back",
      "data": { "action_id": "back", "routeToCardId": "welcome_card" }
    }
  ]
}
